rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rules for user profiles
    match /users/{userId} {
      // Users can read all users (needed for downline query) but only write their own
      allow read: if request.auth != null;

      // Prevent privilege escalation: users can write to their own profile, but cannot elevate their role to admin
      allow create: if request.auth != null && request.auth.uid == userId &&
                    (!('role' in request.resource.data) || request.resource.data.role != 'admin');

      allow update: if request.auth != null && request.auth.uid == userId &&
                    (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);

      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Admins can manage all packages
    match /packages/{packageId} {
      allow read: if true; // Public can see packages
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
