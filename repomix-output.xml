        padding: '16px 24px',
        boxShadow: 'var(--shadow-ambient)',
        display: 'flex',
        alignItems: 'center',
        gap: '12px',
        maxWidth: '400px',
        animation: 'drawPath 0.3s ease-out'
      }}
    >
