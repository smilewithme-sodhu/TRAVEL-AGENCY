<file path="prisma/schema.prisma">
// =============================================================================
// PROJECT 1 — MASTER DATABASE SCHEMA
// Luxury Travel Commerce + Membership + Binary Referral + Immutable Ledger
// Version 1.0 — 11 September 2026
//
// GOVERNANCE RULES (ENFORCED AT SCHEMA LEVEL):
//   1. Zero Balance Mutations   : No balance scalar on Member. All balances
//                                 are computed by aggregating WalletTransaction.
//   2. Source Linking           : Every Reward row requires a sourceBookingId
//                                 pointing to an eligible Booking.
//   3. High-Precision Math      : All monetary / volume fields use Decimal(12, 2).
//   4. Immutable Ledger         : WalletTransaction and RewardLedger have no
//                                 UPDATE surface; reversals are new DEBIT rows.
//   5. Versioned Rules          : Every reward calculation records ruleVersionId.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext]
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  CUSTOMER
  MEMBER
  ADMIN
  SUPER_ADMIN
}

/// 11-state deterministic booking state machine (Section 10 of Blueprint).
enum BookingStatus {
  QUOTE_REQUESTED
  QUOTE_CREATED
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  BOOKING_CONFIRMED // Triggers PENDING rewards and binary volume creation.
  TRAVEL_UPCOMING
  TRAVELING
  COMPLETED // Releases PENDING rewards to AVAILABLE for withdrawal.
  CANCELLED // Freezes / reverses pending reward allocations.
  REFUND_PROCESS
  REFUNDED // Appends REVERSED transactions to the ledger.
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Green = member has a qualifying personal travel booking in the current cycle.
enum MemberGreenStatus {
  GREEN
  INACTIVE
  SUSPENDED
}

enum PackageType {
  DOMESTIC
  INTERNATIONAL
}

enum PackageStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

/// All possible transaction types on the append-only WalletTransaction ledger.
enum TransactionType {
  CREDIT_DIRECT_REWARD
  CREDIT_TEAM_REWARD
  CREDIT_BINARY_REWARD
  CREDIT_MANUAL_ADJUSTMENT
  DEBIT_WITHDRAWAL
  DEBIT_REVERSAL
  DEBIT_MANUAL_ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  APPROVED
  AVAILABLE
  PAID
  REVERSED
  FAILED
}

/// Reward lifecycle mirrors WalletTransaction status but is tracked separately
/// per reward event to support per-reward audit and reversal.
enum RewardStatus {
  PENDING
  APPROVED
  AVAILABLE
  PAID
  REVERSED
}

enum RewardType {
  DIRECT
  TEAM
  BINARY
}

enum TreeSide {
  LEFT
  RIGHT
}


enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  NET_BANKING
  CREDIT_CARD
  DEBIT_CARD
  WALLET
  BANK_TRANSFER
  CASH
}

enum RefundStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  BOOKING_STATE_CHANGE
  REWARD_CREATED
  REWARD_REVERSED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_PAID
  BINARY_VOLUME_CREATED
  BINARY_VOLUME_REVERSED
  RULE_VERSION_ACTIVATED
  ADMIN_ACTION
}

// =============================================================================
// MODEL 1 — User
// Core auth identity. One row per human being.
// =============================================================================
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  phone           String    @unique
  passwordHash    String
  role            Role      @default(CUSTOMER)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  member         Member?
  adminUser      AdminUser?
  notifications  Notification[]
  auditLogs      AuditLog[]      @relation("AuditSubject")
  actorLogs      AuditLog[]      @relation("AuditActor")
  supportTickets SupportTicket[]

  @@index([email])
  @@index([phone])
  @@index([role, isActive])
  @@map("users")
}

// =============================================================================
// MODEL 2 — Member
// Membership identity. 1:1 with User. Source of truth for referral identity.
// FINANCIAL INVARIANT: No balance scalar here. All balances computed from
// WalletTransaction aggregation.
// =============================================================================
model Member {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String            @unique @db.Uuid
  memberId            String            @unique // Human-readable: e.g. TRV8821
  referralCode        String            @unique // Slug used in /r/<referralCode>
  greenStatus         MemberGreenStatus @default(INACTIVE)
  greenActivatedAt    DateTime?
  greenExpiresAt      DateTime?
  qualifyingBookingId String?           @db.Uuid // FK set after first eligible booking
  placedInTreeAt      DateTime?
  joinedAt            DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  qualifyingBooking   Booking?       @relation("QualifyingBooking", fields: [qualifyingBookingId], references: [id], onDelete: SetNull)
  membership          Membership?
  wallet              Wallet?
  binaryNode          BinaryNode?
  referralsGiven      Referral[]     @relation("ReferrerMember")
  referralsReceived   Referral[]     @relation("ReferredMember")
  rewards             Reward[]
  rewardLedgerEntries RewardLedger[]
  withdrawals         Withdrawal[]
  bankAccounts        BankAccount[]
  bookings            Booking[]      @relation("MemberBookings")

  @@index([memberId])
  @@index([referralCode])
  @@index([greenStatus])
  @@index([userId])
  @@map("members")
}

// =============================================================================
// MODEL 3 — Membership
// Records the membership payment event. Not a balance column.
// =============================================================================
model Membership {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId    String           @unique @db.Uuid
  status      MembershipStatus @default(ACTIVE)
  feePaid     Decimal          @db.Decimal(12, 2)
  paymentId   String?          @unique @db.Uuid // FK to Payment when paid via gateway
  activatedAt DateTime         @default(now())
  expiresAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  member  Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([memberId, status])
  @@index([status])
  @@map("memberships")
}

// =============================================================================
// MODEL 4 — Referral
// Immutable attribution record. Created once per referred booking/customer.
// =============================================================================
model Referral {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerMemberId   String    @db.Uuid
  referredMemberId   String?   @db.Uuid // Null if referred customer never became a member
  referredUserId     String?   @db.Uuid
  bookingId          String?   @db.Uuid
  attributedAt       DateTime  @default(now())
  sessionToken       String? // Attribution token stored in browser session
  isValid            Boolean   @default(true)
  invalidatedAt      DateTime?
  invalidationReason String?
  createdAt          DateTime  @default(now())

  // Relations
  referrerMember Member   @relation("ReferrerMember", fields: [referrerMemberId], references: [id], onDelete: Restrict)
  referredMember Member?  @relation("ReferredMember", fields: [referredMemberId], references: [id], onDelete: SetNull)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([referrerMemberId, bookingId]) // Prevent duplicate attribution per booking
  @@index([referrerMemberId])
  @@index([referredMemberId])
  @@index([bookingId])
  @@index([referrerMemberId, isValid])
  @@map("referrals")
}

// =============================================================================
// MODEL 5 — Destination
// Travel content entity.
// =============================================================================
model Destination {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  country      String
  region       String?
  description  String   @db.Text
  heroImageUrl String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  packages Package[]

  @@index([slug])
  @@index([isActive])
  @@map("destinations")
}

// =============================================================================
// MODEL 6 — Package
// Catalogue entry. Pricing is versioned in PackagePrice.
// =============================================================================
model Package {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId      String        @db.Uuid
  slug               String        @unique
  name               String
  packageType        PackageType
  durationNights     Int
  maxTravellers      Int
  highlights         String[]
  inclusions         String[]
  exclusions         String[]
  cancellationPolicy String        @db.Text
  status             PackageStatus @default(DRAFT)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  destination Destination    @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  prices      PackagePrice[]
  quotes      Quote[]
  bookings    Booking[]

  @@index([destinationId])
  @@index([packageType, status])
  @@index([status])
  @@map("packages")
}

// =============================================================================
// MODEL 7 — PackagePrice
// Versioned pricing record. Admin creates a new row to change price.
// Previous rows are preserved for historical audit.
// =============================================================================
model PackagePrice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId         String    @db.Uuid
  validFrom         DateTime
  validTo           DateTime?
  supplierCost      Decimal   @db.Decimal(12, 2)
  operationalCost   Decimal   @db.Decimal(12, 2)
  paymentCost       Decimal   @db.Decimal(12, 2)
  taxAmount         Decimal   @db.Decimal(12, 2)
  sellingPrice      Decimal   @db.Decimal(12, 2)
  grossContribution Decimal   @db.Decimal(12, 2)
  isActive          Boolean   @default(true)
  createdBy         String    @db.Uuid // AdminUser.id
  createdAt         DateTime  @default(now())

  // Relations
  package  Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([packageId, isActive])
  @@index([packageId, validFrom])
  @@map("package_prices")
}

// =============================================================================
// MODEL 8 — Traveller
// Individual guest profile associated with a booking.
// =============================================================================
model Traveller {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String   @db.Uuid
  firstName       String
  lastName        String
  dateOfBirth     DateTime @db.Date
  passportNo      String?
  aadhaarNo       String?
  nationality     String
  isLeadTraveller Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("travellers")
}

// =============================================================================
// MODEL 9 — Quote
// Quote lifecycle. Admin-created response to a customer quote request.
// =============================================================================
model Quote {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId         String      @db.Uuid
  customerId        String      @db.Uuid // User.id
  referralId        String?     @db.Uuid
  travelDateFrom    DateTime    @db.Date
  travelDateTo      DateTime    @db.Date
  numTravellers     Int
  customizations    Json?
  quotedPrice       Decimal     @db.Decimal(12, 2)
  supplierCost      Decimal     @db.Decimal(12, 2)
  grossContribution Decimal     @db.Decimal(12, 2)
  status            QuoteStatus @default(DRAFT)
  expiresAt         DateTime?
  acceptedAt        DateTime?
  createdBy         String      @db.Uuid // AdminUser.id
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  package Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  booking Booking?

  @@index([customerId])
  @@index([packageId, status])
  @@index([status])
  @@map("quotes")
}

// =============================================================================
// MODEL 10 — Booking
// Central state machine. Transitions drive all reward and volume events.
// =============================================================================
model Booking {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRef     String   @unique // Human-readable: e.g. BK-2026-00001
  customerId     String   @db.Uuid // User.id of the customer
  memberId       String?  @db.Uuid // Member.id if customer is a member
  packageId      String   @db.Uuid
  packagePriceId String   @db.Uuid
  quoteId        String?  @unique @db.Uuid
  referralId     String?  @db.Uuid
  travelDateFrom DateTime @db.Date
  travelDateTo   DateTime @db.Date
  numTravellers  Int

  // Financial snapshot at time of booking (immutable after BOOKING_CONFIRMED)
  sellingPrice        Decimal @db.Decimal(12, 2)
  supplierCost        Decimal @db.Decimal(12, 2)
  operationalCost     Decimal @db.Decimal(12, 2)
  paymentCost         Decimal @db.Decimal(12, 2)
  taxAmount           Decimal @db.Decimal(12, 2)
  grossContribution   Decimal @db.Decimal(12, 2)
  directRewardBudget  Decimal @db.Decimal(12, 2)
  teamRewardBudget    Decimal @db.Decimal(12, 2)
  binaryVolumeBudget  Decimal @db.Decimal(12, 2)
  refundReserveBudget Decimal @db.Decimal(12, 2)
  netContribution     Decimal @db.Decimal(12, 2)

  // State machine
  status             BookingStatus @default(QUOTE_REQUESTED)
  confirmedAt        DateTime?
  travelStartedAt    DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  packagePrice         PackagePrice        @relation(fields: [packagePriceId], references: [id], onDelete: Restrict)
  package              Package             @relation(fields: [packageId], references: [id], onDelete: Restrict)
  quote                Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  member               Member?             @relation("MemberBookings", fields: [memberId], references: [id], onDelete: SetNull)
  referrals            Referral[]
  travellers           Traveller[]
  payments             Payment[]
  refunds              Refund[]
  rewards              Reward[]
  rewardLedgers        RewardLedger[]
  binaryVolumeEvents   BinaryVolumeEvent[]
  qualifyingForMembers Member[]            @relation("QualifyingBooking")

  @@index([customerId])
  @@index([memberId])
  @@index([status])
  @@index([memberId, status])
  @@index([referralId])
  @@index([travelDateFrom])
  @@index([packageId, status])
  @@map("bookings")
}

// =============================================================================
// MODEL 11 — Payment
// Gateway transaction record. Idempotent by gatewayOrderId.
// =============================================================================
model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String?       @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR") @db.VarChar(3)
  method           PaymentMethod
  status           PaymentStatus @default(INITIATED)
  gatewayProvider  String
  gatewayOrderId   String        @unique
  gatewayPaymentId String?
  gatewaySignature String?
  webhookPayload   Json?
  paidAt           DateTime?
  failedAt         DateTime?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  membership Membership?
  refunds    Refund[]

  @@index([bookingId])
  @@index([gatewayOrderId])
  @@index([status])
  @@index([bookingId, status])
  @@map("payments")
}

// =============================================================================
// MODEL 12 — Refund
// Refund record linked to originating payment. Triggers reward reversal.
// =============================================================================
model Refund {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String       @db.Uuid
  paymentId       String       @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("INR") @db.VarChar(3)
  status          RefundStatus @default(INITIATED)
  gatewayRefundId String?      @unique
  reason          String?
  initiatedBy     String       @db.Uuid // AdminUser.id
  initiatedAt     DateTime     @default(now())
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// =============================================================================
// MODEL 13 — Commission
// Financial safety snapshot per booking. Source of truth for margin accounting.
// =============================================================================
model Commission {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String   @unique @db.Uuid
  ruleVersionId      String   @db.Uuid
  sellingPrice       Decimal  @db.Decimal(12, 2)
  supplierCost       Decimal  @db.Decimal(12, 2)
  operationalCost    Decimal  @db.Decimal(12, 2)
  paymentCost        Decimal  @db.Decimal(12, 2)
  taxAmount          Decimal  @db.Decimal(12, 2)
  grossContribution  Decimal  @db.Decimal(12, 2)
  directRewardAlloc  Decimal  @db.Decimal(12, 2)
  teamRewardAlloc    Decimal  @db.Decimal(12, 2)
  binaryRewardAlloc  Decimal  @db.Decimal(12, 2)
  refundReserveAlloc Decimal  @db.Decimal(12, 2)
  netContribution    Decimal  @db.Decimal(12, 2)
  calculatedAt       DateTime @default(now())

  // Relations
  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("commissions")
}

// =============================================================================
// MODEL 14 — Reward
// One reward event per (member, booking, rewardType, level).
// INVARIANT: sourceBookingId MUST NOT be null. No booking = no reward.
// =============================================================================
model Reward {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId         String       @db.Uuid
  sourceBookingId  String?      @db.Uuid
  ruleVersionId    String       @db.Uuid
  rewardType       RewardType
  level            Int?
  baseAmount       Decimal      @db.Decimal(12, 2)
  rate             Decimal      @db.Decimal(8, 6)
  calculatedAmount Decimal      @db.Decimal(12, 2)
  capAmount        Decimal?     @db.Decimal(12, 2)
  adjustmentAmount Decimal      @default(0) @db.Decimal(12, 2)
  finalAmount      Decimal      @db.Decimal(12, 2)
  status           RewardStatus @default(PENDING)
  approvedAt       DateTime?
  availableAt      DateTime?
  paidAt           DateTime?
  reversedAt       DateTime?
  reversalReason   String?
  idempotencyKey   String       @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  member        Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sourceBooking Booking?       @relation(fields: [sourceBookingId], references: [id], onDelete: Restrict)
  ruleVersion   RuleVersion    @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  ledgerEntries RewardLedger[]

  @@unique([memberId, sourceBookingId, rewardType, level])
  @@index([memberId, status])
  @@index([sourceBookingId])
  @@index([memberId, rewardType])
  @@index([status])
  @@map("rewards")
}

// =============================================================================
// MODEL 15 — RewardLedger
// Append-only double-entry log of reward state transitions.
// Reversals create new DEBIT rows — never delete or mutate rows.
// =============================================================================
model RewardLedger {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rewardId        String            @db.Uuid
  memberId        String            @db.Uuid
  sourceBookingId String?           @db.Uuid
  transactionType TransactionType
  status          TransactionStatus
  amount          Decimal           @db.Decimal(12, 2)
  notes           String?
  createdBy       String?           @db.Uuid // AdminUser.id if manual entry
  createdAt       DateTime          @default(now())

  // Relations
  reward        Reward   @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sourceBooking Booking? @relation(fields: [sourceBookingId], references: [id], onDelete: Restrict)

  @@index([rewardId])
  @@index([memberId])
  @@index([memberId, status])
  @@index([sourceBookingId])
  @@map("reward_ledger")
}

// =============================================================================
// MODEL 16 — BinaryNode
// One node per member in the binary placement tree.
// =============================================================================
model BinaryNode {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId     String    @unique @db.Uuid
  parentId     String?   @db.Uuid
  side         TreeSide?
  leftChildId  String?   @unique @db.Uuid
  rightChildId String?   @unique @db.Uuid
  depth        Int       @default(0)
  path         String // Materialized path: "/parentUuid/uuid/"
  placedAt     DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Self-referential relations
  member       Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  parent       BinaryNode?         @relation("ParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children     BinaryNode[]        @relation("ParentChild")
  leftChild    BinaryNode?         @relation("LeftChild", fields: [leftChildId], references: [id], onDelete: SetNull)
  leftParent   BinaryNode?         @relation("LeftChild")
  rightChild   BinaryNode?         @relation("RightChild", fields: [rightChildId], references: [id], onDelete: SetNull)
  rightParent  BinaryNode?         @relation("RightChild")
  volumeEvents BinaryVolumeEvent[]

  @@index([parentId])
  @@index([path])
  @@index([memberId])
  @@map("binary_nodes")
}

// =============================================================================
// MODEL 17 — BinaryVolumeEvent
// Individual volume event per booking per node per side.
// INVARIANT: Every row must have sourceBookingId.
// =============================================================================
model BinaryVolumeEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  binaryNodeId    String    @db.Uuid
  sourceBookingId String?   @db.Uuid
  memberId        String    @db.Uuid
  treeSide        TreeSide
  eligibleAmount  Decimal   @db.Decimal(12, 2)
  matchedAmount   Decimal   @default(0) @db.Decimal(12, 2)
  carryForward    Decimal   @default(0) @db.Decimal(12, 2)
  cycleId         String?   @db.Uuid
  isReversed      Boolean   @default(false)
  reversalReason  String?
  reversedAt      DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  binaryNode    BinaryNode @relation(fields: [binaryNodeId], references: [id], onDelete: Restrict)
  sourceBooking Booking?   @relation(fields: [sourceBookingId], references: [id], onDelete: Restrict)

  @@index([binaryNodeId])
  @@index([binaryNodeId, treeSide])
  @@index([sourceBookingId])
  @@index([binaryNodeId, isReversed])
  @@index([cycleId])
  @@map("binary_volume_events")
}

// =============================================================================
// MODEL 18 — Wallet
// Per-member ledger header. Holds NO balance scalar.
// Available balance = SUM(CREDIT transactions) - SUM(DEBIT transactions)
//   WHERE status IN (AVAILABLE, PAID) for credits
// =============================================================================
model Wallet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @unique @db.Uuid
  currency  String   @default("INR") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  member       Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  @@map("wallets")
}

// =============================================================================
// MODEL 19 — WalletTransaction
// Append-only immutable ledger row. NEVER UPDATE OR DELETE.
// Reversals = new DEBIT_REVERSAL row. SELECT ... FOR UPDATE wraps withdrawals.
// =============================================================================
model WalletTransaction {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String            @db.Uuid
  rewardId        String?           @db.Uuid
  withdrawalId    String?           @db.Uuid
  transactionType TransactionType
  status          TransactionStatus
  amount          Decimal           @db.Decimal(12, 2)
  balanceAfter    Decimal           @db.Decimal(12, 2) // Running snapshot for display
  notes           String?
  idempotencyKey  String            @unique
  createdAt       DateTime          @default(now())

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([walletId, transactionType])
  @@index([walletId, status])
  @@index([rewardId])
  @@index([withdrawalId])
  @@map("wallet_transactions")
}

// =============================================================================
// MODEL 20 — Withdrawal
// Payout request lifecycle. Balance locked via SELECT ... FOR UPDATE.
// =============================================================================
model Withdrawal {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId        String           @db.Uuid
  walletId        String           @db.Uuid
  bankAccountId   String?          @db.Uuid
  upiId           String?
  requestedAmount Decimal          @db.Decimal(12, 2)
  approvedAmount  Decimal?         @db.Decimal(12, 2)
  tdsAmount       Decimal          @default(0) @db.Decimal(12, 2)
  netPayoutAmount Decimal?         @db.Decimal(12, 2)
  status          WithdrawalStatus @default(REQUESTED)
  reviewNotes     String?
  rejectionReason String?
  requestedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  rejectedAt      DateTime?
  gatewayRef      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([memberId, status])
  @@index([status])
  @@index([walletId])
  @@map("withdrawals")
}



// =============================================================================
// MODEL 22 — BankAccount
// Member's verified bank account for payouts.
// =============================================================================
model BankAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId          String    @db.Uuid
  accountHolderName String?
  bankName          String?
  accountNumber     String? // Encrypted at application layer
  ifscCode          String?
  upiId             String?
  accountType       String? // SAVINGS | CURRENT
  isPrimary         Boolean   @default(false)
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  @@index([memberId])
  @@index([memberId, isPrimary])
  @@map("bank_accounts")
}

// =============================================================================
// MODEL 23 — Notification
// Multi-channel notification record.
// =============================================================================
model Notification {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @db.Uuid
  channel       NotificationChannel
  status        NotificationStatus  @default(QUEUED)
  subject       String?
  body          String              @db.Text
  metadata      Json?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([channel, status])
  @@map("notifications")
}

// =============================================================================
// MODEL 24 — SupportTicket
// Concierge and post-sale support pipeline.
// =============================================================================
model SupportTicket {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                @db.Uuid
  bookingId   String?               @db.Uuid
  subject     String
  description String                @db.Text
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(NORMAL)
  assignedTo  String?               @db.Uuid // AdminUser.id
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([status, priority])
  @@map("support_tickets")
}

// =============================================================================
// MODEL 25 — AdminUser
// Back-office operator. Separate identity layer from customer/member.
// =============================================================================
model AdminUser {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @db.Uuid
  displayName        String
  department         String?
  isTwoFactorEnabled Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("admin_users")
}

// =============================================================================
// MODEL 26 — AuditLog
// Immutable append-only event history. Never updated or deleted.
// =============================================================================
model AuditLog {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId       String?     @db.Uuid // User.id of who performed the action (null = system)
  subjectId     String?     @db.Uuid // User.id of who was affected
  action        AuditAction
  entity        String // Domain/table name e.g. "bookings"
  entityId      String? // Row UUID of the affected entity
  previousState Json? // Snapshot before change
  newState      Json? // Snapshot after change
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  occurredAt    DateTime    @default(now())

  // Relations
  actor   User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject User? @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([subjectId])
  @@index([action])
  @@index([entity, entityId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// =============================================================================
// MODEL 27 — RuleVersion
// Versioned reward rules engine. Every calculation records this version so
// finance can reproduce historical calculations exactly.
// =============================================================================
model RuleVersion {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version                      String    @unique // SemVer e.g. "1.0.0"
  description                  String
  isActive                     Boolean   @default(false) // Only one active at a time
  // Direct reward
  directRewardRate             Decimal   @db.Decimal(8, 6) // e.g. 0.050000 = 5%
  directRewardCap              Decimal   @db.Decimal(12, 2)
  // Team reward — JSON array: [{level: 1, rate: 0.02, cap: 500}, ...]
  teamRewardLevels             Json
  // Binary matching
  binaryMatchRate              Decimal   @db.Decimal(8, 6)
  binaryMatchCap               Decimal   @db.Decimal(12, 2)
  binaryCarryForwardExpireDays Int       @default(90)
  // Minimum qualifying booking values
  minDomesticVolume            Decimal   @db.Decimal(12, 2)
  minInternationalVolume       Decimal   @db.Decimal(12, 2)
  // Hard budget guardrail
  maxRewardBudgetPercent       Decimal   @db.Decimal(5, 2) // Max % of grossContribution
  activatedAt                  DateTime?
  deactivatedAt                DateTime?
  createdBy                    String    @db.Uuid // AdminUser.id
  createdAt                    DateTime  @default(now())

  // Relations
  rewards     Reward[]
  commissions Commission[]

  @@index([isActive])
  @@index([version])
  @@map("rule_versions")
}
