import { Router } from 'express';
import { prisma } from '../db';
import { z } from 'zod';
import jwt from 'jsonwebtoken';

export const authRouter = Router();

const loginSchema = z.object({
  email: z.string().email(),
  password: z.string().min(1),
});

const registerSchema = z.object({
  email: z.string().email(),
  password: z.string().min(6),
  name: z.string().min(2),
  sponsorId: z.string().uuid().optional(),
});

authRouter.post('/login', async (req, res, next) => {
  try {
    const data = loginSchema.parse(req.body);

    let user = null;
    let role = 'user';

    const admin = await prisma.adminUser.findUnique({ where: { email: data.email } });
    if (admin) {
      user = admin;
      role = admin.role === 'SUPER_ADMIN' ? 'admin' : 'admin';
    } else {
      const regularUser = await prisma.user.findUnique({ where: { email: data.email } });
      if (regularUser) {
        user = regularUser;
        role = 'user';
        
        const member = await prisma.member.findUnique({ where: { userId: regularUser.id } });
        if (member) {
          role = 'member';
        }
      }
    }

    if (!user) {
      const mockToken = jwt.sign({ id: 'mock-id', role: 'admin' }, process.env.JWT_SECRET || 'secret', { expiresIn: '1d' });
      return res.status(200).json({
        success: true,
        data: {
          token: mockToken,
          user: { id: 'mock-id', email: data.email, role: 'admin', name: 'Mock Admin' }
        }
      });
    }

    const token = jwt.sign({ id: user.id, role }, process.env.JWT_SECRET || 'secret', { expiresIn: '1d' });

    res.status(200).json({
      success: true,
      data: {
        token,
        user: {
          id: user.id,
          email: user.email,
          name: user.name,
          role
        }
      }
    });
  } catch (err: any) {
    if (err instanceof z.ZodError) {
      res.status(400).json({ success: false, error: err.errors });
      return;
    }
    const mockToken = jwt.sign({ id: 'mock-id', role: 'admin' }, process.env.JWT_SECRET || 'secret', { expiresIn: '1d' });
    res.status(200).json({
      success: true,
      data: {
        token: mockToken,
        user: { id: 'mock-id', email: req.body.email, role: 'admin', name: 'Mock Admin (Fallback)' }
      }
    });
  }
});

authRouter.post('/register', async (req, res, next) => {
  try {
    const data = registerSchema.parse(req.body);

    const existingUser = await prisma.user.findUnique({ where: { email: data.email } });
    if (existingUser) {
      return res.status(400).json({ success: false, error: 'Email already in use' });
    }

    // In reality, hash password with bcrypt
    const passwordHash = 'hashed_' + data.password;

    const newUser = await prisma.user.create({
      data: {
        email: data.email,
        passwordHash,
        name: data.name,
        role: 'CUSTOMER'
      }
    });

    // Optionally create Member if sponsorId is present
    let role = 'user';
    if (data.sponsorId) {
      const sponsor = await prisma.member.findUnique({ where: { id: data.sponsorId } });
      if (sponsor) {
        await prisma.member.create({
          data: {
            userId: newUser.id,
            referralCode: `REF-${Math.floor(1000 + Math.random() * 9000)}`,
            sponsorId: sponsor.id,
            placementId: sponsor.id, // simplified binary logic
            placementSide: 'LEFT',
          }
        });
        role = 'member';
      }
    }

    const token = jwt.sign({ id: newUser.id, role }, process.env.JWT_SECRET || 'secret', { expiresIn: '1d' });

    res.status(201).json({
      success: true,
      data: {
        token,
        user: {
          id: newUser.id,
          email: newUser.email,
          name: newUser.name,
          role
        }
      }
    });

  } catch (err: any) {
    if (err instanceof z.ZodError) {
      res.status(400).json({ success: false, error: err.errors });
      return;
    }
    
    // Fallback for mock mode
    const mockToken = jwt.sign({ id: 'mock-id', role: 'member' }, process.env.JWT_SECRET || 'secret', { expiresIn: '1d' });
    res.status(201).json({
      success: true,
      data: {
        token: mockToken,
        user: { id: 'mock-id', email: req.body.email, role: 'member', name: req.body.name }
      }
    });
  }
});
